// 프로그래머스
// JadenCase 문자열 만들기  LV2

import java.util.*;

class Solution {
    public String solution(String s) {
        boolean start = true; // 첫 문자를 대문자로 바꾸기 위해서 설정, true일때 소문자->대문자로 바꾸기
        StringBuilder sb = new StringBuilder();
        
        for(int i=0; i<s.length(); i++) {
            char c = s.charAt(i);
            if(Character.isLetter(c)) { // 알파벳일때
                if(start) { // start가 true이면 대문자로 변환해서 추가
                    sb.append(Character.toUpperCase(c));
                    start = false;
                }
                else   // start가 false일때는 소문자로 추가
                    sb.append(Character.toLowerCase(c));
            }
            
            else if(c == ' ') { // 공백일때는 공백그대로 추가하고 start=true로 설정.(알파벳 대문자 변환용도)
                start = true;
                sb.append(' ');
            }
            
            else {  // 숫자일떄는 그냥 추가하고 start = false;
                sb.append(c);                            
                start = false;
            }
                
        }
        
        return sb.toString();
    }
}
