// 프로그래머스 LV3 입국심사

import java.util.*;

class Solution {
    public long solution(int n, int[] times) {
        // 심사 시간을 오름차순 정렬
        Arrays.sort(times);

        long left = 1;
        // 최대 가능 시간, 가장 오래 걸리는 심사관이 모든 사람을 처리하는 경우        
        long right = (long)times[times.length - 1] * n;
        long answer = right;

        while(left <= right) {
            long mid = (left + right) / 2;
            long count = 0;
            for(int time : times) {
                count += mid / time;
            }

            // 더 작은 시간으로도 가능한지 탐색
            if(count >= n) {
                answer = mid;
                right = mid - 1;
            }
            else {
                left = mid + 1;
            }
        }

        return answer;
    }
}
