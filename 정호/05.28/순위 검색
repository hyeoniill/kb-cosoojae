// 프로그래머스 LV2

import java.util.*;

class Solution {
    static HashMap<String, ArrayList<Integer>> map = new HashMap<>();

    public int[] solution(String[] info, String[] query) {        
        for(String s : info) {
            String[] arr = s.split(" ");        
            String[] temp = new String[4];

            for(int i = 0; i < 4; i++) {
                temp[i] = arr[i];
            }        
            int score = Integer.parseInt(arr[4]);
            DFS(0, "", temp, score);
        }

        // 점수 정렬
        for(String key : map.keySet()) {
            Collections.sort(map.get(key));
        }

        int[] answer = new int[query.length];
        // query 처리
        for(int i = 0; i < query.length; i++) {
            // and 제거
            String str = query[i].replaceAll(" and ", " ");
            String[] arr = str.split(" ");
            // key 생성
            String key = arr[0] + arr[1] + arr[2] + arr[3];
            // 기준 점수
            int score = Integer.parseInt(arr[4]);

            // 해당 key 없으면 0
            if(!map.containsKey(key)) {
                answer[i] = 0;
                continue;
            }
            ArrayList<Integer> list = map.get(key);

            // lower bound 직접 구현
            int left = 0;
            int right = list.size();

            while(left < right) {

                int mid = (left + right) / 2;

                // target 이상이면 더 왼쪽 탐색
                if(list.get(mid) >= score) {
                    right = mid;
                }
                // target보다 작으면 오른쪽 탐색
                else {
                    left = mid + 1;
                }
            }

            // score 이상 개수
            answer[i] = list.size() - left;
        }

        return answer;
    }

    // 모든 조합 생성
    static void DFS(int depth, String str, String[] arr, int score) {

        // 조건 4개 완성
        if(depth == 4) {

            map.putIfAbsent(str, new ArrayList<>());
            map.get(str).add(score);

            return;
        }

        // 실제 값 사용
        DFS(depth + 1, str + arr[depth], arr, score);

        // - 사용
        DFS(depth + 1, str + "-", arr, score);
    }
}
