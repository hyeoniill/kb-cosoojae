// 프로그래머스 모의고사 LV1
import java.util.*;

class Solution {
    public int[] solution(int[] answers) {
        int[] one = {1,2,3,4,5};
        int[] two = {2,1,2,3,2,4,2,5};
        int[] three = {3,3,1,1,2,2,4,4,5,5};
        
        int[] count = new int[3]; // 수포자1,2,3번 정답 개수 저장하는 배열
        
        for(int i=0; i<answers.length; i++) { // answers 순회하면서 정답 체크, 맞으면 count배열 증가
            if(answers[i] == one[i%5])
                count[0]++;
            if(answers[i] == two[i%8])
                count[1]++;
            if(answers[i] == three[i%10])
                count[2]++;
        }
        
        ArrayList<Integer> list = new ArrayList<>();
        int max = count[0];
        for(int i=1; i<3; i++) { 
            if(count[i] > max)
                max = count[i];
        }
        
        for(int i=0; i<3; i++) { // 정답 개수가 가장 많은 사람만 list에 추가
            if(count[i] == max)
                list.add(i+1);
        }
        
        int[] answer = new int[list.size()];
        for(int i=0; i<list.size(); i++) {
            answer[i] = list.get(i);
        }
        return answer;
    }
}
