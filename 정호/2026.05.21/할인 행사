// 프로그래머스 - 할인 행사  LV2

import java.util.*;

class Solution {
    public int solution(String[] want, int[] number, String[] discount) {
                
        int answer = 0;
        // 원하는 상품과 개수를 저장
        HashMap<String, Integer> map = new HashMap<>();        
        for(int i = 0; i < want.length; i++) {            
            map.put(want[i], number[i]);
        }
        
        int start = 0;
        int end = discount.length;
        // 현재 10일 할인 상품 정보를 저장할 map2
        HashMap<String, Integer> map2 = new HashMap<>();        
        
        for(int i = 0; i < discount.length; i++) {            
            map2.put(discount[i], map2.getOrDefault(discount[i], 0) + 1);

            // 윈도우 크기가 10 이상이고, 상품 구성이 같을때 가입
            while(i - start + 1 >= 10) {                
                if(map2.equals(map))
                    answer++;

                // 맨 앞 상품 제거
                map2.put(discount[start],
                        map2.get(discount[start]) - 1);

                // 개수가 0이면 map에서 제거
                if(map2.get(discount[start]) == 0) {
                    map2.remove(discount[start]);
                }

                start++;
            }
        }

        return answer;
    }
}
