// 프로그래머스 LV3 인사고과

import java.util.*;

class Solution {
    public int solution(int[][] scores) {

        int wanho0 = scores[0][0];
        int wanho1 = scores[0][1];
        int wanho = wanho0 + wanho1;  // 완호의 근무태도, 동료평가 점수 

        Arrays.sort(scores, (a, b) -> { 첫번째는 내림차순, 두번째는 오름차순
            if (a[0] == b[0])
                return a[1] - b[1];
            return b[0] - a[0];
        });

        List<Integer> list = new ArrayList<>();

        int max = 0;
        boolean wanhoPass = false;

        for (int i = 0; i < scores.length; i++) {

            // 탈락
            if (scores[i][1] < max) {

                // 탈락한 사람이 완호라면 -1을 return하고 아래에 있는건 패스
                if (scores[i][0] == wanho0 && scores[i][1] == wanho1) 
                    return -1;                            
                continue;
                                   
            }
            max = scores[i][1];
            list.add(scores[i][0] + scores[i][1]);

            // 살아남은 완호인지 체크
            if (scores[i][0] == wanho0 && scores[i][1] == wanho1)
                wanhoPass = true;
        }
        Collections.sort(list, Collections.reverseOrder());

        int rank = 1;
        int count = 0;
        int cur = list.get(0);

        if (cur == wanho) // 완호가 1등인 경우 1을 return
            return 1;

        for (int i = 1; i < list.size(); i++) {
            int num = list.get(i);
            if (num == cur) {
                count++;
            } else {
                rank += count + 1;
                count = 0;
                cur = num;
            }

            if (num == wanho)
                return rank;
        }

        return rank;
    }
}
