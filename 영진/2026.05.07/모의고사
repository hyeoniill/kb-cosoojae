import java.util.*;


class Solution {
    public List<Integer> solution(int[] answers) {
        int count_1 = 0;
        int count_2 = 0;
        int count_3 = 0;
        int a_1;
        int a_2;
        int a_3;
        int[] a2 = {1,3,4,5};
        int[] a3 = {3,1,2,4,5};
       
        for(int i =0; i<answers.length; i++){
            a_1 = (i)%5 +1;
            if(i % 2 ==0){a_2 = 2;}
            else{a_2 = a2[(i/2)%4];}
            a_3 = a3[i/2%5];
            if(a_1 == answers[i]) count_1++;
            if(a_2 == answers[i]) count_2++;
            if(a_3 == answers[i]) count_3++;
        }
        int[] answer = {count_1,count_2,count_3};
        int max = Math.max(count_1,Math.max(count_2,count_3));
        
        ArrayList<Integer> list = new ArrayList<>();
        
        for(int i =1; i<=3; i++){
            if(answer[i-1] == max){
                list.add(i);        
            }
        }
        
        return list;
    }
}
