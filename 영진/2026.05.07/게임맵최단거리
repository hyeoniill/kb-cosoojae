import java.util.*;


class Solution {
    public int solution(int[][] maps) {
        Queue<int[]> q = new LinkedList<>();
        
        int dy[] = {-1,0,1,0};
        int dx[] = {0,1,0,-1};
        int[] c;
        int dist[][] = new int[100][100];
        int n = maps.length -1;
        int m = maps[0].length -1;
        dist[0][0] = 1;
        q.add(new int[]{0,0});
        while(!q.isEmpty()){
            c = q.poll();
            int y = c[0];
            int x = c[1];
            if(y == n && x == m) return dist[y][x];
            for(int i =0; i<4; i++){
                int ny = y +dy[i];
                int nx = x + dx[i];
                if(ny<0 || ny > n || nx <0 || nx >m) continue;
                if(dist[ny][nx] !=0 || maps[ny][nx] == 0) continue;
                    q.add(new int[]{ny,nx});
                    dist[ny][nx] = dist[y][x] +1;
                }
        }
        return -1;
    
    }
}
