class Solution {
    public String solution(String s) {


        String answer = "";

        // 전부 소문자로 바꾸기
        s = s.toLowerCase();

        // 첫글자인지 확인용
        boolean first = true;

        for (int i = 0; i < s.length(); i++) {

            char c = s.charAt(i);

            // 첫 글자라면
            if (first == true) {

                // 대문자로 바꾸기
                c = Character.toUpperCase(c);
            }

            // answer에 추가
            answer += c;

            // 공백이면 다음 글자는 첫 글자
            if (c == ' ') {
                first = true;
            }

            // 공백 아니면 다음은 첫 글자 아님
            else {
                first = false;
            }
        }

        return answer;
    }
}
